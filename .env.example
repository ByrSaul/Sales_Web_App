# URL HTTPS pública del proxy, sin barra final. No es un secreto.
VITE_API_BASE_URL=https://your-api-host.example.com/api
# Modo explícito: msal (arquitectura final) o dev-token (sólo desarrollo temporal).
VITE_AUTH_MODE=msal

# Módulos temporalmente ocultos. Ausencia = false (fail closed). Ya implementados; NO borrar código.
VITE_FEATURE_PRODUCTION=false
VITE_FEATURE_FORECAST=false
# TEMPORAL — DEVELOPMENT ONLY — NOT FOR PRODUCTION. VITE_* es visible en el bundle.
VITE_DEV_ACCESS_TOKEN=
# Identificadores de la aplicación SPA registrada en Microsoft Entra ID.
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Scope delegado expuesto por la aplicación Backend.
VITE_AZURE_SCOPE=api://your-backend-application-id/access_as_user
